# ============================================================
# Snort 3 local rules for DVWA lab
# Target:
# - DVWA HTTP on port 8080
# - SSH on port 22
# SIDs: 1000001+
# ============================================================

# 1. DVWA login bruteforce
alert http any any -> $HOME_NET 8080 (
    msg:"LAB DVWA possible login bruteforce";
    flow:to_server,established;
    http_method;
    content:"POST";
    http_uri;
    content:"/login.php";
    detection_filter:track by_src, count 5, seconds 30;
    classtype:web-application-attack;
    sid:1000001;
    rev:1;
)

# 2. SSH bruteforce
alert tcp any any -> $HOME_NET 22 (
    msg:"LAB SSH possible bruteforce connection attempts";
    flags:S;
    detection_filter:track by_src, count 5, seconds 60;
    classtype:attempted-recon;
    sid:1000002;
    rev:1;
)

# 3. SQL Injection - UNION SELECT in URI
alert http any any -> $HOME_NET 8080 (
    msg:"LAB DVWA SQL Injection attempt - UNION SELECT";
    flow:to_server,established;
    http_uri;
    pcre:"/union\s+select/i";
    classtype:web-application-attack;
    sid:1000003;
    rev:2;
)

# 4. SQL Injection - OR 1=1 in URI
alert http any any -> $HOME_NET 8080 (
    msg:"LAB DVWA SQL Injection attempt - OR 1=1";
    flow:to_server,established;
    http_uri;
    pcre:"/(\%27|'|\")?\s*or\s+1\s*=\s*1/i";
    classtype:web-application-attack;
    sid:1000004;
    rev:1;
)

# 5. SQL Injection - SQL comment marker
alert http any any -> $HOME_NET 8080 (
    msg:"LAB DVWA SQL Injection attempt - SQL comment marker";
    flow:to_server,established;
    http_uri;
    content:"--";
    classtype:web-application-attack;
    sid:1000005;
    rev:1;
)

# 6. SQL Injection - time based payloads: sleep() / benchmark()
alert http any any -> $HOME_NET 8080 (
    msg:"LAB DVWA SQL Injection attempt - time based function";
    flow:to_server,established;
    http_uri;
    pcre:"/(sleep|benchmark)\s*\(/i";
    classtype:web-application-attack;
    sid:1000006;
    rev:1;
)

# 7. XSS - script tag
alert http any any -> $HOME_NET 8080 (
    msg:"LAB DVWA XSS attempt - script tag";
    flow:to_server,established;
    http_uri;
    pcre:"/(<|%3c)\s*script/i";
    classtype:web-application-attack;
    sid:1000007;
    rev:1;
)

# 8. XSS - javascript: URI
alert http any any -> $HOME_NET 8080 (
    msg:"LAB DVWA XSS attempt - javascript URI";
    flow:to_server,established;
    http_uri;
    content:"javascript:",nocase;
    classtype:web-application-attack;
    sid:1000008;
    rev:2;
)

# 9. XSS - HTML event handler
alert http any any -> $HOME_NET 8080 (
    msg:"LAB DVWA XSS attempt - HTML event handler";
    flow:to_server,established;
    http_uri;
    pcre:"/on(error|load|mouseover|focus|click)\s*=/i";
    classtype:web-application-attack;
    sid:1000009;
    rev:1;
)

# 10. XSS - img tag payload
alert http any any -> $HOME_NET 8080 (
    msg:"LAB DVWA XSS attempt - img tag";
    flow:to_server,established;
    http_uri;
    pcre:"/(<|%3c)\s*img/i";
    classtype:web-application-attack;
    sid:1000010;
    rev:1;
)

# 11. DVWA Brute Force module
# Detect repeated GET requests to /vulnerabilities/brute/
alert http any any -> $HOME_NET 8080 (
    msg:"LAB DVWA brute force module attempt";
    flow:to_server,established;
    http_uri;
    content:"/vulnerabilities/brute/";
    detection_filter:track by_src, count 5, seconds 30;
    classtype:web-application-attack;
    sid:1000011;
    rev:1;
)

# 12. FTP brute force detection
# Detect repeated TCP SYN connection attempts to FTP port 21
alert tcp any any -> $HOME_NET 21 (
    msg:"LAB FTP possible bruteforce connection attempts";
    flags:S;
    detection_filter:track by_src, count 3, seconds 60;
    classtype:attempted-recon;
    sid:1000012;
    rev:2;
)